+float Mouse::AccelerationGain(float pixels, Common::SteadyClock::time_point now) {
+    if (pixels <= 0.0f) {
+        return 1.0f; // the recentering move that follows every real move: no time passes for speed
+    }
+    const float elapsed_ms = std::chrono::duration<float, std::milli>(now - last_move_time).count();
+    last_move_time = now;
+    if (elapsed_ms > acceleration_idle_ms) {
+        move_speed = 0.0f; // a new movement starts from rest
+    }
+    const float dt_ms = std::clamp(elapsed_ms, 1.0f, 50.0f);
+    move_speed += (pixels / dt_ms - move_speed) * acceleration_smoothing;
+    const float strength = Settings::values.mouse_panning_acceleration.GetValue() / 100.0f;
+    if (strength <= 0.0f) {
+        return 1.0f;
+    }
+    const float t = std::clamp((move_speed - acceleration_threshold) /
+                                   (acceleration_full_speed - acceleration_threshold),
+                               0.0f, 1.0f);
+    return 1.0f + strength * acceleration_max_extra_gain * (t * t * (3.0f - 2.0f * t));
+}
