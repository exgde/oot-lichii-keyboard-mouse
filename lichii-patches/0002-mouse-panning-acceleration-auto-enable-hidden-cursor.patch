+// slow 1000 px/s sweep). Below the threshold the camera follows the pointer 1:1; the gain then
+// rises smoothly to its maximum at the full speed. The setting scales the extra gain (0..100%).
+constexpr float acceleration_threshold = 0.8f;
+constexpr float acceleration_full_speed = 8.0f;
+constexpr float acceleration_max_extra_gain = 3.0f;
+constexpr float acceleration_smoothing = 0.3f;
